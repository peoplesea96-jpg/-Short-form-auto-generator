APP_URL=http://localhost:3100
DATA_DIR=./data
CLIENT_EMAIL=
ADMIN_EMAIL=
ALLOWED_EMAILS=
ALLOW_PUBLIC_SIGNUP=false
SESSION_SECRET=
SMTP_USER=
SMTP_APP_PASSWORD=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
# Set reviewed account rates before enabling paid requests. Never copy blueprint estimates.
RATES_REVIEWED_AT=
SCRIPT_MAX_KRW=
OPENAI_INPUT_KRW_PER_MILLION=
OPENAI_OUTPUT_KRW_PER_MILLION=
USD_TO_KRW=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
GEMINI_VIDEO_MODEL=gemini-omni-1.1-flash
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Sulafat
# Comma-separated approved Gemini voices exposed to clients.
GEMINI_TTS_VOICES=Sulafat
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Reviewed effective account price; no assumed ElevenLabs tariff.
ELEVENLABS_USD_PER_1000_CHARACTERS=
GEMINI_IMAGE_USD_PER_IMAGE=0.0336
GEMINI_VIDEO_USD_PER_SECOND=0.10
GEMINI_TTS_USD_PER_MINUTE=0.03
# Reserve a conservative 10 billed seconds for each Omni scene request.
GEMINI_VIDEO_RESERVE_SECONDS=10
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FONT_PATH=
FONT_NAME=Noto Sans CJK KR

# PRD v4: server-only operator credentials. Never expose via NEXT_PUBLIC_*.
# Paste the complete credential required by Higgsfield Authorization: Key <credential>.
# 영상 모델 연동은 보류: Marketing Studio 광고 이미지는 아래 키로 별도 연결
HIGGSFIELD_ENABLED=false
HIGGSFIELD_API_KEY=
# Marketing Studio: KEY_ID:KEY_SECRET 형식. APP_URL은 외부 접근 가능한 HTTPS 주소.
# 프리셋 선택 후 사용자가 요청별 예약 예산을 확인하며, 확정 견적으로 표시하지 않음.
# 공급자 실제 토큰 청구액은 운영 관리에서 확인·정산 (HIGGSFIELD_ENABLED 불필요).
# Exact hostnames from official signed-upload/result responses, comma separated.
# Confirm with your operator account before enabling paid video generation. No wildcards.
HIGGSFIELD_UPLOAD_HOSTS=
MEDIA_HOSTS=
# Reviewed conservative estimates; blank disables the corresponding paid model.
# GPT reserve must cover output AND all reference-image/text input charges at high quality.
GPT_IMAGE_RESERVE_USD_PER_IMAGE=
HIGGSFIELD_SEEDANCE_480P_USD_PER_SECOND=
HIGGSFIELD_SEEDANCE_720P_USD_PER_SECOND=
HIGGSFIELD_SEEDANCE_1080P_USD_PER_SECOND=
HIGGSFIELD_KLING_USD_PER_SECOND=
HIGGSFIELD_MINIMAX_6S_USD_PER_CLIP=
HIGGSFIELD_MINIMAX_10S_USD_PER_CLIP=
